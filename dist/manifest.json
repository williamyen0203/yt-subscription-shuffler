{
    "manifest_version": 3,
    "name": "Youtube Subscription Shuffler",
    "description": "Play a random video from your list of subscriptions",
    "version": "0.1.0",
    "action": {
        "default_icon": {
            "128": "icon/icon128.png",
            "512": "icon/icon512.png"
        },
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "js/backgroundPage.js"
    },
    "host_permissions": [
        "https://www.googleapis.com/*",
        "https://content-youtube.googleapis.com/*"
    ],
    "permissions": [
        "storage",
        "identity",
        "identity.email"
    ],
    "key": ""
}
