{
    "manifest_version": 3,
    "name": "Youtube Subscription Shuffler",
    "description": "Play a random video from your list of subscriptions",
    "version": "0.1.0",
    "action": {
        "default_icon": "icon.png",
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "js/backgroundPage.js"
    },
    "host_permissions": [
        "https:\/\/*/*"
    ],
    "permissions": [
        "tabs",
        "activeTab",
        "notifications",
        "scripting"
    ]
}